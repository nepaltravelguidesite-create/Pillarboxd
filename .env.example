# Aftershow — TMDB API credentials
# Copy this file to .env and fill in your credentials.
# Get them at: https://www.themoviedb.org/settings/api

# Option A (recommended): v4 Read Access Token (Bearer auth)
VITE_TMDB_READ_TOKEN=

# Option B (fallback): v3 API Key (query-param auth)
VITE_TMDB_API_KEY=

# fanart.tv API key — secondary poster source for curated shows
# Only needed to run scripts/resolve-fanart-posters.mjs (one-time).
# Not required at runtime — the resolved poster map ships statically.
# Get one at: https://fanart.tv/get-an-api-key/
VITE_FANART_API_KEY=
