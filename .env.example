# Aftershow — TMDB API credentials
# Copy this file to .env and fill in your credentials.
# Get them at: https://www.themoviedb.org/settings/api

# Option A (recommended): v4 Read Access Token (Bearer auth)
VITE_TMDB_READ_TOKEN=

# Option B (fallback): v3 API Key (query-param auth)
VITE_TMDB_API_KEY=
